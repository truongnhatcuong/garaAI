generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum VehicleStatus {
  ACTIVE
  IN_REPAIR
  READY
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  ARRIVED
  IN_PROGRESS
  CANCELLED
  COMPLETED
}

enum RepairStatus {
  INTAKE
  WAITING_APPROVAL
  WAITING_PARTS
  REPAIRING
  QUALITY_CHECK
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  PENDING_APPROVAL
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

enum LineType {
  PART
  SERVICE
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum NotificationType {
  INFO
  WARNING
  ERROR
  SUCCESS
}

model Customer {
  id           String        @id @default(cuid())
  name         String
  phone        String?       @unique
  email        String?       @unique
  tier         String        @default("Bronze")
  address      String?
  status       RecordStatus  @default(ACTIVE)
  account      UserAccount?
  vehicles     Vehicle[]
  appointments Appointment[]
  repairOrders RepairOrder[]
  invoices     Invoice[]
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([name])
  @@index([deletedAt, createdAt])
}

model MembershipTier {
  code            String   @id @db.VarChar(20)
  label           String   @db.VarChar(50)
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)
  updatedAt       DateTime @updatedAt
}

model InvoiceSettings {
  id         Int      @id @default(1)
  taxPercent Decimal  @default(0) @db.Decimal(5, 2)
  updatedAt  DateTime @updatedAt
}

model SiteMapSettings {
  id        Int      @id @default(1)
  placeName String   @db.VarChar(100)
  address   String   @db.VarChar(255)
  embedUrl  String   @db.Text
  updatedAt DateTime @updatedAt
}

model Vehicle {
  id           String        @id @default(cuid())
  plate        String        @unique
  name         String
  vin          String?       @unique
  odometerKm   Int?
  warranty     String?
  status       VehicleStatus @default(ACTIVE)
  customerId   String?
  customer     Customer?     @relation(fields: [customerId], references: [id])
  appointments Appointment[]
  repairOrders RepairOrder[]
  invoices     Invoice[]
  bays         WorkshopBay[]
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([customerId, deletedAt])
  @@index([name])
}

model Service {
  id              String            @id @default(cuid())
  code            String            @unique
  title           String
  description     String?           @db.Text
  durationMinutes Int
  price           Decimal           @db.Decimal(14, 2)
  status          RecordStatus      @default(ACTIVE)
  appointments    Appointment[]
  repairLines     RepairOrderLine[]
  deletedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([title])
}

model Employee {
  id             String         @id @default(cuid())
  code           String         @unique
  name           String
  email          String?        @unique
  specialty      String?
  role           String?
  shiftStart     String?
  shiftEnd       String?
  status         RecordStatus   @default(ACTIVE)
  advisedOrders  RepairOrder[]  @relation("AdvisorOrders")
  assignedOrders RepairOrder[]  @relation("TechnicianOrders")
  bays           WorkshopBay[]
  notifications  Notification[]
  account        UserAccount?
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([name])
}

model Appointment {
  id          String            @id @default(cuid())
  code        String            @unique
  customerId  String
  customer    Customer          @relation(fields: [customerId], references: [id])
  vehicleId   String
  vehicle     Vehicle           @relation(fields: [vehicleId], references: [id])
  serviceId   String?
  service     Service?          @relation(fields: [serviceId], references: [id])
  startsAt    DateTime
  endsAt      DateTime?
  notes       String?           @db.Text
  status      AppointmentStatus @default(PENDING)
  repairOrder RepairOrder?
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([startsAt, status])
  @@index([customerId, deletedAt])
}

model AppointmentBookingMutex {
  id      Int @id
  version Int @default(0)
}

model Part {
  id          String            @id @default(cuid())
  sku         String            @unique
  name        String
  brand       String?
  location    String?
  cost        Decimal           @db.Decimal(14, 2)
  price       Decimal           @db.Decimal(14, 2)
  stockQty    Int               @default(0)
  minStock    Int               @default(0)
  unit        String            @default("cái")
  status      RecordStatus      @default(ACTIVE)
  repairLines RepairOrderLine[]
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([name])
  @@index([stockQty])
}

model RepairOrder {
  id            String            @id @default(cuid())
  code          String            @unique
  customerId    String
  customer      Customer          @relation(fields: [customerId], references: [id])
  vehicleId     String
  vehicle       Vehicle           @relation(fields: [vehicleId], references: [id])
  appointmentId String?           @unique
  appointment   Appointment?      @relation(fields: [appointmentId], references: [id])
  advisorId     String?
  advisor       Employee?         @relation("AdvisorOrders", fields: [advisorId], references: [id])
  technicianId  String?
  technician    Employee?         @relation("TechnicianOrders", fields: [technicianId], references: [id])
  scheduledAt   DateTime?
  status        RepairStatus      @default(INTAKE)
  bayCode       String?
  odometerKm    Int?
  diagnosis     String?           @db.Text
  notes         String?           @db.Text
  estimateTotal Decimal?          @db.Decimal(14, 2)
  laborCost     Decimal           @default(0) @db.Decimal(14, 2)
  lines         RepairOrderLine[]
  tasks         RepairTask[]
  evidence      RepairEvidence[]
  invoices      Invoice[]
  deletedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status, scheduledAt])
  @@index([vehicleId, deletedAt])
}

model RepairOrderLine {
  id            String      @id @default(cuid())
  repairOrderId String
  repairOrder   RepairOrder @relation(fields: [repairOrderId], references: [id])
  type          LineType
  partId        String?
  part          Part?       @relation(fields: [partId], references: [id])
  serviceId     String?
  service       Service?    @relation(fields: [serviceId], references: [id])
  description   String
  quantity      Int
  unitPrice     Decimal     @db.Decimal(14, 2)
  total         Decimal     @db.Decimal(14, 2)
  stockNote     String?
  sortOrder     Int         @default(0)

  @@index([repairOrderId, sortOrder])
}

model RepairTask {
  id            String      @id @default(cuid())
  repairOrderId String
  repairOrder   RepairOrder @relation(fields: [repairOrderId], references: [id])
  description   String
  status        TaskStatus  @default(PENDING)
  sortOrder     Int         @default(0)

  @@index([repairOrderId, sortOrder])
}

model RepairEvidence {
  id            String      @id @default(cuid())
  repairOrderId String
  repairOrder   RepairOrder @relation(fields: [repairOrderId], references: [id])
  imageUrl      String      @db.Text
  imageUploadKey String?    @unique
  caption       String?
  sortOrder     Int         @default(0)

  @@index([repairOrderId, sortOrder])
}

model ImageDeletionJob {
  key       String   @id
  createdAt DateTime @default(now())
  attempts  Int      @default(0)
  lastError String?  @db.Text
}

model Invoice {
  id            String        @id @default(cuid())
  code          String        @unique
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  vehicleId     String?
  vehicle       Vehicle?      @relation(fields: [vehicleId], references: [id])
  repairOrderId String?
  repairOrder   RepairOrder?  @relation(fields: [repairOrderId], references: [id])
  issuedAt      DateTime      @default(now())
  subtotal      Decimal       @default(0) @db.Decimal(14, 2)
  discount      Decimal       @default(0) @db.Decimal(14, 2)
  tax           Decimal       @default(0) @db.Decimal(14, 2)
  taxPercent    Decimal?      @db.Decimal(5, 2)
  total         Decimal       @db.Decimal(14, 2)
  status        InvoiceStatus @default(DRAFT)
  payments      Payment[]
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([issuedAt, status])
  @@index([customerId, deletedAt])
}

model Payment {
  id        String        @id @default(cuid())
  code      String        @unique
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id])
  amount    Decimal       @db.Decimal(14, 2)
  method    PaymentMethod @default(OTHER)
  status    PaymentStatus @default(PENDING)
  paidAt    DateTime?
  notes     String?
  deletedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([invoiceId, status])
  @@index([paidAt])
}

model Notification {
  id         String           @id @default(cuid())
  title      String
  body       String?          @db.Text
  type       NotificationType @default(INFO)
  employeeId String?
  employee   Employee?        @relation(fields: [employeeId], references: [id])
  readAt     DateTime?
  deletedAt  DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([employeeId, readAt])
}

model WorkshopBay {
  id         String    @id @default(cuid())
  code       String    @unique
  vehicleId  String?
  vehicle    Vehicle?  @relation(fields: [vehicleId], references: [id])
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])
  statusText String?
  progressNote String?   @db.Text
  reportedAt   DateTime?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Report {
  id          String       @id @default(cuid())
  periodStart DateTime     @unique
  revenue     Decimal      @db.Decimal(14, 2)
  cost        Decimal      @db.Decimal(14, 2)
  profit      Decimal      @db.Decimal(14, 2)
  status      RecordStatus @default(ACTIVE)
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Expense {
  id        String   @id @default(cuid())
  title     String
  amount    Decimal  @db.Decimal(14, 2)
  spentAt   DateTime @default(now())
  deletedAt DateTime?
  createdAt DateTime @default(now())

  @@index([spentAt, deletedAt])
}

enum UserRole {
  ADMIN
  CUSTOMER
  EMPLOYEE
}

model UserAccount {
  id           String    @id @default(cuid())
  name         String?
  phone        String?
  email        String    @unique
  passwordHash String
  role         UserRole  @default(CUSTOMER)
  customerId   String?   @unique
  customer     Customer? @relation(fields: [customerId], references: [id])
  employeeId   String?   @unique
  employee     Employee? @relation(fields: [employeeId], references: [id])
  sessions     Session[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Session {
  id        String      @id @default(cuid())
  tokenHash String      @unique
  userId    String
  user      UserAccount @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime    @default(now())

  @@index([userId, expiresAt])
}
